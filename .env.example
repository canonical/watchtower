# Copy this file to .env and fill in real values before running.
# .env is git-ignored — never commit secrets.

# --- Mattermost Bot credentials ---
# Create a Bot Account in System Console → Integrations → Bot Accounts,
# then generate a token for it. All three vars must be set to enable the bot;
# any one missing disables Mattermost integration (falls back to stdout REPL).
#
# MATTERMOST_SERVER_URL=http://192.168.1.193:8065
# MATTERMOST_BOT_TOKEN=your-bot-token-here
# MATTERMOST_BOT_USER_ID=abcdefghijklmnopqrstuvwxyz   # user ID of the bot account
#
# To find the bot user ID, call:
#   curl -H "Authorization: Bearer <token>" http://<server>/api/v4/users/me | jq .id

# --- Mattermost Polling mode (alternative — no bot account required) ---
# Uses a personal access token from any regular user account to poll a single
# channel for keyword mentions. Activate by setting all three vars below.
# Both the polling mode and the WebSocket bot can be active at the same time;
# enabling either does not disable the other.
#
# MATTERMOST_SERVER_URL=http://192.168.1.193:8065   # shared with bot mode above
# MATTERMOST_POLL_TOKEN=your-personal-access-token  # User Settings → Security → Personal Access Tokens
# MATTERMOST_CHANNEL_ID=abcdefghijklmnopqrstuvwx    # channel to watch and post proactive summaries to
#
# To find a channel ID: System Console → Channels → click the channel → copy the ID,
# or: curl -H "Authorization: Bearer <token>" http://<server>/api/v4/channels/search \
#         -d '{"term":"<channel-name>"}' | jq '.[].id'
#
# How often to poll for new posts in the channel (Go duration string).
# Default: 30s
# MATTERMOST_POLL_INTERVAL=30s

# Keyword that must appear in a message for the bot/poller to respond.
# Users write: @watchtower help  (or reply in a thread with @watchtower).
# Default: @watchtower
# WATCHTOWER_KEYWORD=@watchtower

# Restrict proactive (scheduled) summary posts to specific channel IDs (bot mode only).
# Comma-separated list of Mattermost channel IDs. When set, the bot only posts
# to those channels instead of every channel it has joined.
# Default: empty (broadcast to all joined public/private channels)
# MATTERMOST_BROADCAST_CHANNEL_IDS=channel-id-1,channel-id-2

# How long to wait before reconnecting after a WebSocket disconnect (Go duration string).
# Default: 5s
# MATTERMOST_RECONNECT_DELAY=5s

# --- General overrides (defaults shown) ---
# WATCHTOWER_RELEASES_SCOPE=noble,jammy  # ordered comma-separated releases to scope all operations
#                                        # (fetch, diff, summary, failures); empty = all releases
# SUMMARY_FOR_PRODUCTS=ubuntu-desktop,ubuntu-server  # comma-separated OS/product names; empty = all
# TEST_OBSERVER_URL=https://tests-api.ubuntu.com
# TEMPORAL_HOST=localhost:7233

# --- Cron schedules ---
# How often to refresh the internal dataset from Test Observer (standard cron syntax).
# REFRESH_CRON_SCHEDULE=*/30 * * * *   # default: every 30 min

# When to post the scheduled build summary to the channel (standard cron syntax, UTC).
# Default: 07:00, 15:00, 23:00 UTC (adjust for your timezone).
# SUMMARY_CRON_SCHEDULE=0 7,15,23 * * *   # UTC — equals 08:00/16:00/00:00 CET (UTC+1)

# When to run LLM failure analysis (standard cron syntax, UTC). Default: every 8 hours.
# FAILURE_ANALYSIS_CRON_SCHEDULE=0 */8 * * *

# Maximum number of LLM log analysis calls per analysis run (token cap). Default: 5.
# MAX_FAILURES_PER_ANALYSIS_RUN=5

# TODO: uncomment when log analysis is implemented
# OPENROUTER_API_KEY=your-openrouter-api-key-here
# LLM_MODEL=anthropic/claude-sonnet-4-5
